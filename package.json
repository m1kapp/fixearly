{
  "name": "fixearly",
  "version": "0.5.0",
  "description": "JS/TS 코드에서 고칠 줄을 짚는다 — 규칙은 react·node·angular 등 남의 저장소에 머지된 것들. 100% 로컬 정적 분석",
  "type": "module",
  "bin": {
    "fixearly": "bin/fixearly.mjs"
  },
  "files": [
    "bin/fixearly.mjs",
    "bin/sweep.mjs",
    "bin/deps-audit.mjs"
  ],
  "keywords": [
    "static-analysis",
    "bug-finder",
    "lint",
    "javascript",
    "typescript",
    "cli"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "typescript": "^5.4.0"
  },
  "license": "MIT",
  "homepage": "https://fixearly.m1k.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m1kapp/fixearly.git"
  },
  "bugs": {
    "url": "https://github.com/m1kapp/fixearly/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "python3 -m http.server 4173",
    "test": "node bin/selftest.mjs && node bin/impact.mjs --selftest && node tools/test-deps-audit.mjs && python3 tools/check-false-positives.py && python3 tools/fetch-repo-contributors.py --selftest && python3 tools/fetch-repo-contributors.py --check && python3 tools/update-impact-cards.test.py && python3 tools/update-impact-cards.py --check && python3 tools/update-pr-queue.py --check",
    "impact": "node bin/impact.mjs",
    "pre-pr": "node tools/pre-pr-check.mjs",
    "merge-times": "python3 tools/update-repo-merge-times.py",
    "cards": "python3 tools/fetch-repo-avatars.py && python3 tools/update-impact-cards.py",
    "contributors": "python3 tools/fetch-repo-contributors.py",
    "avatars": "python3 tools/fetch-repo-avatars.py",
    "queue": "python3 tools/update-pr-queue.py",
    "prepublishOnly": "npm test",
    "alive": "python3 tools/check-merged-alive.py"
  }
}
